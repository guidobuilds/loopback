{
  "description": "Input -> expected redaction cases for scripts/redact (feature A5). 'expected' is the exact redacted output for short inputs; 'mustNotContain' lists patterns that must be gone for any case. A scripted case-runner asserts each.",
  "cases": [
    {
      "name": "email",
      "input": "contact caffaguido@gmail.com about the defect",
      "expected": "contact [redacted-email] about the defect",
      "mustNotContain": ["@"]
    },
    {
      "name": "github-pat",
      "input": "token ghp_AbCdEf0123456789AbCdEf0123456789xyz leaked",
      "expected": "token [redacted-token] leaked",
      "mustNotContain": ["ghp_"]
    },
    {
      "name": "aws-key",
      "input": "key AKIAIOSFODNN7EXAMPLE in env",
      "expected": "key [redacted-token] in env",
      "mustNotContain": ["AKIA"]
    },
    {
      "name": "openai-key",
      "input": "the key sk-AbCdEf0123456789AbCdEf0123456789 is secret",
      "expected": "the key [redacted-token] is secret",
      "mustNotContain": ["sk-"]
    },
    {
      "name": "abs-posix-path",
      "input": "wrote /Users/guido/dev/prd.md freeform",
      "expected": "wrote [redacted-path] freeform",
      "mustNotContain": ["/Users/", "prd.md"]
    },
    {
      "name": "bare-filename",
      "input": "the auth.ts module was reverted",
      "expected": "the [redacted-file] module was reverted",
      "mustNotContain": ["auth.ts"]
    },
    {
      "name": "bearer-token",
      "input": "header Authorization: Bearer abc123def456ghi789 set",
      "expected": "header Authorization: Bearer [redacted-token] set",
      "mustNotContain": ["abc123def456ghi789"]
    },
    {
      "name": "already-redacted-idempotent",
      "input": "wrote [redacted-path] and emailed [redacted-email]",
      "expected": "wrote [redacted-path] and emailed [redacted-email]",
      "mustNotContain": ["@", "/Users/"]
    },
    {
      "name": "prose-slashes-passthrough",
      "input": "PRDs should use the Problem/Solution/Metrics template",
      "expected": "PRDs should use the Problem/Solution/Metrics template",
      "mustNotContain": ["[redacted"]
    },
    {
      "name": "tcp-ip-passthrough",
      "input": "We use TCP/IP for transport",
      "expected": "We use TCP/IP for transport",
      "mustNotContain": ["[redacted"]
    },
    {
      "name": "and-or-passthrough",
      "input": "ship the skill and/or the agent",
      "expected": "ship the skill and/or the agent",
      "mustNotContain": ["[redacted"]
    },
    {
      "name": "real-abs-path-with-file",
      "input": "leaked /Users/alice/secret/notes.md here",
      "expected": "leaked [redacted-path] here",
      "mustNotContain": ["/Users/", "notes.md"]
    },
    {
      "name": "tilde-relative-path-with-file",
      "input": "open ~/work/x.py to edit",
      "expected": "open [redacted-path] to edit",
      "mustNotContain": ["~/work", "x.py"]
    },
    {
      "name": "email-amid-prose-slashes",
      "input": "Problem/Solution/Metrics; ping jane.doe@acme.com",
      "expected": "Problem/Solution/Metrics; ping [redacted-email]",
      "mustNotContain": ["@"]
    },
    {
      "name": "ghp-token-amid-prose-slashes",
      "input": "TCP/IP debug used ghp_AbCdEf0123456789AbCdEf0123456789xyz",
      "expected": "TCP/IP debug used [redacted-token]",
      "mustNotContain": ["ghp_"]
    }
  ]
}
